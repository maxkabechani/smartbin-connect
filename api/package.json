{
  "name": "smartbin-fastify-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "auth:generate": "bunx --bun auth@latest generate --adapter drizzle --dialect postgresql"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.0",
    "@better-auth/drizzle-adapter": "^1.7.4",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.2",
    "drizzle-seed": "^0.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
